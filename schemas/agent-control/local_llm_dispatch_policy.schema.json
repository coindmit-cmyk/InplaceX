{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aistudio.local/schemas/agent-control/local_llm_dispatch_policy.schema.json",
  "title": "Local LLM Dispatch Policy",
  "type": "object",
  "required": ["schema_version", "promotion_threshold", "task_kinds"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "promotion_threshold": {
      "type": "object",
      "required": ["attempts", "successes", "failures"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "successes": { "type": "integer", "minimum": 1 },
        "failures": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "llm_candidate": { "type": "boolean" },
        "execution_mode": { "enum": ["codex_only", "parallel_debug", "llm_only"] }
      },
      "additionalProperties": true
    },
    "queue": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "concurrency_per_kind": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "pre_worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_tasks_per_cycle": { "type": "integer", "minimum": 1, "maximum": 1 },
        "max_attempts_per_task": { "type": "integer", "minimum": 1 },
        "fallback": { "enum": ["codex"] },
        "task_kinds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "idle_learning": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["advisory_only"] },
        "max_prompts_per_cycle": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "topics": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "execution_host": {
      "type": "object",
      "properties": {
        "required_kind": { "enum": ["remote_pc"] },
        "owner_laptop_allowed": { "type": "boolean" },
        "owner_laptop_role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "packet_mode": { "enum": ["full_worker_packet", "summary_packet"] },
        "include_doc_refs": { "type": "boolean" },
        "include_input_refs": { "type": "boolean" },
        "include_allowed_path_evidence": { "type": "boolean" },
        "include_all_project_docs": { "type": "boolean" },
        "redact_secrets": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "granularity": {
      "type": "object",
      "properties": {
        "max_complexity": { "enum": ["XS", "S", "M", "L", "XL"] },
        "max_allowed_paths": { "type": "integer", "minimum": 1 },
        "max_checks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "task_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["llm_candidate", "execution_mode"],
        "properties": {
          "llm_candidate": { "type": "boolean" },
          "execution_mode": { "enum": ["codex_only", "parallel_debug", "llm_only"] },
          "model": { "type": "string" },
          "prompt": { "type": "string" },
          "triage_only": { "type": "boolean" },
          "triage_route_on_pass": { "enum": ["evidence_only", "dispatcher_repair"] },
          "queue": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "concurrency_per_kind": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          },
          "granularity": {
            "type": "object",
            "properties": {
              "max_complexity": { "enum": ["XS", "S", "M", "L", "XL"] },
              "max_allowed_paths": { "type": "integer", "minimum": 1 },
              "max_checks": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          },
          "promotion_threshold": {
            "type": "object",
            "properties": {
              "attempts": { "type": "integer", "minimum": 1 },
              "successes": { "type": "integer", "minimum": 1 },
              "failures": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "attempts": { "type": "integer", "minimum": 0 },
              "successes": { "type": "integer", "minimum": 0 },
              "failures": { "type": "integer", "minimum": 0 },
              "last_evaluated_at": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

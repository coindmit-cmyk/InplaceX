{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aistudio.local/schemas/agent-control/artifact_discovery_finding.schema.json",
  "title": "Artifact Discovery Finding",
  "type": "object",
  "required": ["id", "detected_at", "detector", "path", "artifact_type", "category", "severity", "confidence", "suggested_owner", "suggested_action", "blocking_gate"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "detected_at": {"type": "string"},
    "detector": {"type": "string"},
    "path": {"type": "string"},
    "artifact_type": {"type": "string"},
    "category": {"type": "string"},
    "severity": {"type": "string", "enum": ["info", "advisory", "warning", "blocking", "critical"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "current_scope": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "related_refs": {"type": "array", "items": {"type": "string"}},
    "suggested_owner": {"type": "string"},
    "suggested_task_type": {"type": "string"},
    "suggested_action": {"type": "string"},
    "blocking_gate": {"type": "string"},
    "auto_task_allowed": {"type": "boolean"}
  },
  "additionalProperties": true
}

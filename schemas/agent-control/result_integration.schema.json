{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aistudio.local/agent-control/result_integration.schema.json",
  "title": "AIStudio Result Integration Contract",
  "description": "Exact result accounting, conflict disposition and digest-bound synthesis for Finalizer verification. Integration grants no launch or merge authority.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "stage", "project_id"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "stage": {"$ref": "#/$defs/id"},
        "project_id": {"$ref": "#/$defs/id"}
      }
    },
    "authority_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_granted",
        "role_permissions_changed",
        "approval_gates_bypassed",
        "worker_ready_changed",
        "merge_authority_granted",
        "release_authority_granted",
        "recurring_automation_changed"
      ],
      "properties": {
        "authority_granted": {"const": false},
        "role_permissions_changed": {"const": false},
        "approval_gates_bypassed": {"const": false},
        "worker_ready_changed": {"const": false},
        "merge_authority_granted": {"const": false},
        "release_authority_granted": {"const": false},
        "recurring_automation_changed": {"const": false}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_ref", "reason_codes"],
      "properties": {
        "journal_ref": {"type": "string", "minLength": 1},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "attempt_id", "work_unit_id", "criticality"],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "work_unit_id": {"$ref": "#/$defs/id"},
        "criticality": {"enum": ["required", "optional"]},
        "skill_bindings_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "received": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "invocation_id",
        "attempt_id",
        "work_unit_id",
        "status",
        "result_envelope_digest"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/id"},
        "invocation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "work_unit_id": {"$ref": "#/$defs/id"},
        "status": {
          "enum": [
            "success",
            "partial",
            "failed",
            "timed_out",
            "cancelled",
            "blocked",
            "rejected"
          ]
        },
        "result_envelope_digest": {"$ref": "#/$defs/digest"},
        "skill_bindings_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "attempt_id",
        "work_unit_id",
        "disposition",
        "reason_code"
      ],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "work_unit_id": {"$ref": "#/$defs/id"},
        "disposition": {
          "enum": [
            "accepted",
            "excluded",
            "failed",
            "missing",
            "cancelled",
            "not_run",
            "rejected",
            "stale"
          ]
        },
        "result_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/id"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "classification",
        "risk",
        "blocking",
        "parties",
        "claim_refs",
        "evidence_refs",
        "resolution"
      ],
      "properties": {
        "conflict_id": {"$ref": "#/$defs/id"},
        "classification": {
          "enum": [
            "factual",
            "evidence",
            "requirement_interpretation",
            "architecture",
            "implementation",
            "state",
            "path_artifact",
            "policy_authority",
            "staleness",
            "scope",
            "security",
            "irreversible"
          ]
        },
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "blocking": {"type": "boolean"},
        "parties": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "claim_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "rationale",
            "selected_positions",
            "rejected_positions",
            "residual_risk"
          ],
          "properties": {
            "status": {"enum": ["resolved", "unresolved", "routed"]},
            "method": {
              "enum": [
                "owner_decision",
                "hard_policy",
                "verified_reality",
                "reproducible_evidence",
                "domain_expertise",
                "majority",
                "confidence",
                "unresolved"
              ]
            },
            "rationale": {"type": "string", "minLength": 1},
            "selected_positions": {
              "type": "array",
              "items": {"$ref": "#/$defs/id"}
            },
            "rejected_positions": {
              "type": "array",
              "items": {"$ref": "#/$defs/id"}
            },
            "residual_risk": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "minLength": 1}
              ]
            }
          }
        }
      }
    },
    "next_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "kind",
        "reason_code",
        "target_role",
        "target_stage",
        "capability_profile",
        "reasoning_effort",
        "authorization_granted",
        "execution_started"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["targeted_retry", "specialist", "owner_escalation"]},
        "reason_code": {"$ref": "#/$defs/id"},
        "target_role": {"$ref": "#/$defs/id"},
        "target_stage": {"$ref": "#/$defs/id"},
        "capability_profile": {
          "enum": [
            "efficient",
            "balanced",
            "deep",
            "maximum_coherent",
            "delegated_deep"
          ]
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "extra_high", "max", "ultra"]
        },
        "authorization_granted": {"const": false},
        "execution_started": {"const": false}
      }
    }
  },
  "required": [
    "contract_version",
    "contract_kind",
    "correlation_id",
    "producer",
    "created_at",
    "revision",
    "supersedes",
    "digest_profile",
    "authority_guard",
    "audit",
    "integration_id",
    "status",
    "plan_id",
    "plan_content_digest",
    "input_result_set_digest",
    "expected_results",
    "received_results",
    "orphan_results",
    "result_accounting",
    "requirement_coverage",
    "lane_coverage",
    "conflicts",
    "blockers",
    "synthesis",
    "integration_digest"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "contract_kind": {"const": "result_integration"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "producer": {"$ref": "#/$defs/producer"},
    "created_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/id"}
      ]
    },
    "digest_profile": {"const": "jcs-sha256-v1"},
    "authority_guard": {"$ref": "#/$defs/authority_guard"},
    "audit": {"$ref": "#/$defs/audit"},
    "integration_id": {"$ref": "#/$defs/id"},
    "status": {
      "enum": [
        "ready_for_finalizer",
        "accepted_with_residual_risk",
        "integration_incomplete",
        "rerun_required",
        "owner_decision_required",
        "rejected"
      ]
    },
    "plan_id": {"$ref": "#/$defs/id"},
    "plan_content_digest": {"$ref": "#/$defs/digest"},
    "input_result_set_digest": {"$ref": "#/$defs/digest"},
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/expected"}
    },
    "received_results": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/received"}
    },
    "orphan_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "reason_code"],
        "properties": {
          "result_id": {"$ref": "#/$defs/id"},
          "reason_code": {"$ref": "#/$defs/id"}
        }
      }
    },
    "result_accounting": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/accounting"}
    },
    "requirement_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence_refs"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/id"},
          "status": {"enum": ["covered", "partial", "missing", "blocked"]},
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "lane_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_unit_id",
          "status",
          "chosen_attempt_id",
          "chosen_result_id",
          "superseded_attempt_ids",
          "reason_code"
        ],
        "properties": {
          "work_unit_id": {"$ref": "#/$defs/id"},
          "status": {
            "enum": [
              "accepted",
              "excluded",
              "failed",
              "missing",
              "cancelled",
              "not_run",
              "rejected",
              "stale"
            ]
          },
          "chosen_attempt_id": {
            "oneOf": [
              {"$ref": "#/$defs/id"},
              {"type": "null"}
            ]
          },
          "chosen_result_id": {
            "oneOf": [
              {"$ref": "#/$defs/id"},
              {"type": "null"}
            ]
          },
          "superseded_attempt_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "reason_code": {"$ref": "#/$defs/id"},
          "skill_bindings_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_code", "human_reason"],
        "properties": {
          "reason_code": {"$ref": "#/$defs/id"},
          "human_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "accepted_result_ids",
        "excluded_results",
        "accepted_claim_ids",
        "excluded_claims",
        "requirement_coverage",
        "artifacts",
        "preservation_checks",
        "residual_risks",
        "confidence",
        "confidence_method",
        "weakest_critical_evidence_confidence",
        "synthesis_digest"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
        "accepted_result_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "excluded_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_id", "reason_code"],
            "properties": {
              "result_id": {"$ref": "#/$defs/id"},
              "reason_code": {"$ref": "#/$defs/id"}
            }
          }
        },
        "accepted_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "excluded_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "reason_code"],
            "properties": {
              "claim_id": {"$ref": "#/$defs/id"},
              "reason_code": {"$ref": "#/$defs/id"}
            }
          }
        },
        "requirement_coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "digest"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        },
        "preservation_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "evidence_ref"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["passed", "failed", "not_run"]},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "residual_risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_method": {
          "enum": ["weakest_critical_evidence", "bounded_expert_judgment"]
        },
        "weakest_critical_evidence_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "synthesis_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "next_run_request": {"$ref": "#/$defs/next_run"},
    "finalizer_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "integration_id",
        "integration_digest",
        "synthesis_digest",
        "input_result_set_digest",
        "package_evidence_digest",
        "required_accounting_complete",
        "blocking_conflicts_resolved",
        "required_checks_passed",
        "finalizer_may_modify",
        "merge_authority_granted"
      ],
      "properties": {
        "handoff_id": {"$ref": "#/$defs/id"},
        "integration_id": {"$ref": "#/$defs/id"},
        "integration_digest": {"$ref": "#/$defs/digest"},
        "synthesis_digest": {"$ref": "#/$defs/digest"},
        "input_result_set_digest": {"$ref": "#/$defs/digest"},
        "package_evidence_digest": {"$ref": "#/$defs/digest"},
        "required_accounting_complete": {"const": true},
        "blocking_conflicts_resolved": {"const": true},
        "required_checks_passed": {"const": true},
        "finalizer_may_modify": {"const": false},
        "merge_authority_granted": {"const": false}
      }
    },
    "integration_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"revision": {"minimum": 2}},
        "required": ["revision"]
      },
      "then": {
        "properties": {"supersedes": {"$ref": "#/$defs/id"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "ready_for_finalizer"}},
        "required": ["status"]
      },
      "then": {
        "required": ["finalizer_handoff"],
        "properties": {
          "blockers": {"maxItems": 0},
          "synthesis": {
            "properties": {"residual_risks": {"maxItems": 0}}
          }
        },
        "not": {"required": ["next_run_request"]}
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "accepted_with_residual_risk"}
        },
        "required": ["status"]
      },
      "then": {
        "required": ["finalizer_handoff"],
        "properties": {
          "blockers": {"maxItems": 0},
          "synthesis": {
            "properties": {"residual_risks": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "integration_incomplete",
              "owner_decision_required",
              "rejected"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {"blockers": {"minItems": 1}},
        "not": {"required": ["finalizer_handoff"]}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "rerun_required"}},
        "required": ["status"]
      },
      "then": {
        "required": ["next_run_request"],
        "properties": {"blockers": {"minItems": 1}},
        "not": {"required": ["finalizer_handoff"]}
      }
    }
  ]
}

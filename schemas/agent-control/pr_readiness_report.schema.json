{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRReadinessReport",
  "type": "object",
  "required": ["schema_version", "created_at", "base_branch", "items", "counts"],
  "properties": {
    "schema_version": {"type": "integer"},
    "created_at": {"type": "string"},
    "project_root": {"type": ["string", "null"]},
    "base_branch": {"type": "string"},
    "base_sha": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branch", "classification", "risk_class", "reason", "next_owner"],
        "properties": {
          "branch": {"type": ["string", "null"]},
          "pr": {"type": ["integer", "null"]},
          "task_ids": {"type": "array", "items": {"type": "string"}},
          "classification": {"type": "string"},
          "risk_class": {"type": "string"},
          "changed_paths": {"type": "array", "items": {"type": "string"}},
          "coordination_changed_paths": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"},
          "next_owner": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "counts": {"type": "object"},
    "risk_counts": {"type": "object"}
  },
  "additionalProperties": true
}

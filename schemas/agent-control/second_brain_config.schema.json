{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aistudio.local/schemas/agent-control/second_brain_config.schema.json",
  "title": "AiStudio Second Brain Local Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storage"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_db", "bulk_archive_root"],
      "properties": {
        "active_db": {"type": "string", "minLength": 1},
        "bulk_archive_root": {"type": "string", "minLength": 1}
      }
    },
    "pattern_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "project_id"],
      "properties": {
        "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_results": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    }
  }
}

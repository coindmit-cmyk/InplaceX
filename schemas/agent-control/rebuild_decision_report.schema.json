{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RebuildDecisionReport",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "items",
    "counts",
    "contract_valid"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "next_owner",
          "reason",
          "next_event"
        ]
      }
    },
    "counts": {
      "type": "object"
    },
    "contract_valid": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}


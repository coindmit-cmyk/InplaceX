# Optional local/CI environment variables for InplaceX.
# Android provider ids are configured through local.properties, not through this file.
# Do not put real secrets in files committed to the repository.

JAVA_HOME=
ANDROID_HOME=
ANDROID_SDK_ROOT=

# Local Docker Compose stack. Copy this file to .env and replace the password
# placeholder before starting the backend. Keep the resulting .env private.
INPLACEX_POSTGRES_DB=inplacex
INPLACEX_POSTGRES_USER=inplacex
INPLACEX_POSTGRES_PASSWORD=change-me-before-use
INPLACEX_POSTGRES_VOLUME=inplacex-postgres-data
INPLACEX_BACKEND_PORT=8080

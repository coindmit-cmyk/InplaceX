  "include_disabled_projects": false,
  "max_shadow_age_seconds": 900,
  "backup_manifest": "/srv/aistudio-hdd/task-control-postgres/latest.manifest.json",
  "runtime_root": "/home/agent/agent-runtime/task-control",
  "session_ttl_seconds": 14400
}

{
  "$schema": "../../schemas/agent-control/task_control_database.schema.json",
  "schema_version": 1,
  "mode": "cutover",
  "source_of_truth": "postgres",
  "cutover_enabled": true,
  "dsn_env": "AISTUDIO_TASK_DB_DSN",
  "registry_path": "/home/agent/agent-runtime/chat-bridge/projects.local.json",
  "required_project_ids": [
    "ai-project-agent",
    "e-shop",
    "residentguard",
    "myvpn",
    "inplacex"

# Legacy standalone-service contract. The production Compose GeoIP timer reads
# /etc/inplacex-online/backend.env and does not load this file.
# Safe contract for a backend process behind nginx on loopback.
# The MMDB file is public geolocation data, not a secret.
INPLACEX_AD_MARKET_REQUIRED=true
INPLACEX_AD_MARKET_DB_PATH=/var/lib/inplacex/geoip/dbip-country-lite.mmdb
INPLACEX_AD_MARKET_CLIENT_IP_HEADER=X-InplaceX-Client-IP
INPLACEX_AD_MARKET_TRUSTED_PROXY_HOSTS=localhost,127.0.0.1,::1

# Operational values must match the deployed service and its actual loopback port.
INPLACEX_AD_MARKET_SERVICE=inplacex-backend.service
INPLACEX_AD_MARKET_INTERNAL_URL=http://127.0.0.1:18080

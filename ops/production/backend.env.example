COMPOSE_PROJECT_NAME=inplacex-online-production

# Both images must be immutable references. Tags without @sha256 are rejected.
INPLACEX_BACKEND_IMAGE=registry.example/mirkori/inplacex-backend@sha256:REPLACE_WITH_64_LOWERCASE_HEX
INPLACEX_POSTGRES_IMAGE=docker.io/library/postgres@sha256:REPLACE_WITH_64_LOWERCASE_HEX

# This port is intentionally separate from Mirkori Games Platform. Inventory the
# target host before changing it; do not assume that 8080 or 18080 is free.
INPLACEX_BACKEND_LOOPBACK_PORT=18081

INPLACEX_POSTGRES_DB=inplacex
INPLACEX_POSTGRES_USER=inplacex
INPLACEX_POSTGRES_VOLUME=inplacex-online-postgres-data
INPLACEX_SECRET_DIRECTORY=/etc/inplacex-online/secrets
# Dedicated host group shared only with the two container runtimes. The deploy
# validates root:GID 0750 for the directory and root:GID 0640 for each secret.
INPLACEX_RUNTIME_SECRET_GID=21081
INPLACEX_GEOIP_DB_PATH=/var/lib/inplacex/geoip/dbip-country-lite.mmdb
# Durable, root-owned release journal and verified activation state. Never put
# this directory under /run or another tmpfs.
INPLACEX_RELEASE_STATE_DIRECTORY=/var/lib/inplacex-online/release-state

INPLACEX_ONLINE_TOKEN_ISSUER=mirkori-platform
INPLACEX_ONLINE_TOKEN_AUDIENCE=mirkori-games
INPLACEX_MATCHMAKING_BOT_FALLBACK_SECONDS=5
# Leave empty for normal migrations. Set only for the documented one-time
# v1-v8 or v1-v9 checksum-baseline recovery, then remove it immediately.
INPLACEX_DATABASE_LEGACY_CHECKSUM_BASELINE_ACK=

# Exact address that Ktor sees for the local nginx proxy (often a Docker bridge
# gateway). Determine it from a live request; never trust arbitrary forwarders.
INPLACEX_AD_MARKET_TRUSTED_PROXY_HOSTS=REPLACE_WITH_EXACT_PROXY_ADDRESS
INPLACEX_AD_MARKET_COUNTRY_HEADER=
INPLACEX_AD_MARKET_CONTAINER_DB_PATH=/var/lib/inplacex/geoip/dbip-country-lite.mmdb

# Exact public HTTPS server and the single operator/VPN network permitted to
# read health/readiness/release metadata through nginx.
INPLACEX_PUBLIC_HOSTNAME=online.example.com
INPLACEX_OPERATOR_NETWORK_CIDR=192.0.2.10/32
INPLACEX_DRAIN_TIMEOUT_SECONDS=60

# Leave empty normally. During a planned platform signing-key rotation, replace
# the public-key file, confirm that the old backend stopped fail closed, then set
# this to the SHA-256 from the current verified activation for one deployment.
INPLACEX_ALLOW_PUBLIC_KEY_ROTATION_FROM_SHA256=
# Leave empty after activation v2 exists. For the one deploy that migrates an
# exact running activation v1, set the documented acknowledgement below; do not
# combine it with secret, GeoIP, runtime-config, or public-key rotation.
INPLACEX_ACTIVATION_V1_MIGRATION_ACK=

INPLACEX_RELEASE_ID=inplacex-backend-REPLACE
INPLACEX_GIT_SHA=REPLACE_WITH_40_LOWERCASE_HEX
INPLACEX_IMAGE_DIGEST=sha256:REPLACE_WITH_THE_BACKEND_IMAGE_DIGEST
INPLACEX_SOURCE_ARCHIVE_SHA256=REPLACE_WITH_BUILD_MANIFEST_SOURCE_SHA256
INPLACEX_RELEASE_MANIFEST_PATH=/var/lib/inplacex-online/releases/inplacex-backend-REPLACE.json

# Existing production installs must use false. true is accepted only when no
# project PostgreSQL/backend containers exist and the external volume is empty.
INPLACEX_INITIAL_DEPLOY=false
INPLACEX_COMPOSE_WAIT_TIMEOUT_SECONDS=120

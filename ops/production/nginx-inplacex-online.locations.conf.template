# Include this file inside the HTTPS server block that owns the configured InplaceX
# online origin. TLS and trusted real-IP configuration remain host-level policy.

error_page 429 = @inplacex_online_rate_limited;
location @inplacex_online_rate_limited {
    default_type application/json;
    add_header Retry-After 1 always;
    return 429 '{"error":"rate_limited"}';
}

location ^~ /api/v1/ws/ {
    include /etc/nginx/snippets/inplacex-online-maintenance-gate.conf;
    include /etc/nginx/snippets/inplacex-online-websocket-rate-limit.conf;
    proxy_pass http://127.0.0.1:@@INPLACEX_BACKEND_LOOPBACK_PORT@@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
    proxy_read_timeout 70s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    client_max_body_size 96k;
}

location ^~ /api/v1/matchmaking/ {
    include /etc/nginx/snippets/inplacex-online-maintenance-gate.conf;
    include /etc/nginx/snippets/inplacex-online-rest-rate-limit.conf;
    proxy_pass http://127.0.0.1:@@INPLACEX_BACKEND_LOOPBACK_PORT@@;
    include /etc/nginx/snippets/inplacex-online-rest-proxy.conf;
}

location ^~ /api/v1/friends/ {

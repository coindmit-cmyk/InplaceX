location = /api/v1/runtime/ad-market {
    include /etc/nginx/snippets/inplacex-online-maintenance-gate.conf;
    include /etc/nginx/snippets/inplacex-online-rest-rate-limit.conf;
    proxy_pass http://127.0.0.1:@@INPLACEX_BACKEND_LOOPBACK_PORT@@;
    include /etc/nginx/snippets/inplacex-online-rest-proxy.conf;
    include /etc/nginx/snippets/inplacex-ad-market-proxy.conf;
}

# Operator-only smoke endpoints use an InplaceX prefix so they can coexist with
# Mirkori Games Platform on the same HTTPS origin.
location = /inplacex/health {
    include /etc/nginx/snippets/inplacex-online-maintenance-gate.conf;
    allow 127.0.0.1;
    allow ::1;
    allow @@INPLACEX_OPERATOR_NETWORK_CIDR@@;
    deny all;
    limit_req zone=inplacex_online_operator burst=4 nodelay;
    limit_req_status 429;
    limit_conn inplacex_online_operator_connections 5;
    limit_conn_status 429;
    proxy_pass http://127.0.0.1:@@INPLACEX_BACKEND_LOOPBACK_PORT@@/health;
    include /etc/nginx/snippets/inplacex-online-rest-proxy.conf;
}


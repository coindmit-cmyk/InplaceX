[Unit]
Description=Mirkori Games Telegram APK catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirkori-games
Group=mirkori-games
SupplementaryGroups=mirkori-platform
WorkingDirectory=/srv/agent-projects/mirkori-games-bot/current
EnvironmentFile=/etc/mirkori-games-bot.env
ExecStart=/usr/bin/python3 /srv/agent-projects/mirkori-games-bot/current/bot.py --platform-catalog /srv/mirkori-games-platform/catalog/current/catalog.json --artifact-root /srv/mirkori-games-platform/catalog/current/artifacts --offset-file /srv/agent-projects/mirkori-games-bot/state/update-offset
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/agent-projects/mirkori-games-bot/current /srv/mirkori-games-platform/catalog
ReadWritePaths=/srv/agent-projects/mirkori-games-bot/state

[Install]
WantedBy=multi-user.target

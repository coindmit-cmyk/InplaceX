[Unit]
Description=Mirkori Games Telegram APK catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirkori-games
Group=mirkori-games
WorkingDirectory=/srv/agent-projects/mirkori-games-bot/current
EnvironmentFile=/etc/mirkori-games-bot.env
ExecStart=/usr/bin/python3 /srv/agent-projects/mirkori-games-bot/current/bot.py --catalog /srv/agent-projects/mirkori-games-bot/catalog/games.json --artifact-root /srv/agent-projects/mirkori-games-bot/downloads --offset-file /srv/agent-projects/mirkori-games-bot/state/update-offset
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/agent-projects/mirkori-games-bot/current /srv/agent-projects/mirkori-games-bot/catalog /srv/agent-projects/mirkori-games-bot/downloads
ReadWritePaths=/srv/agent-projects/mirkori-games-bot/state

[Install]
WantedBy=multi-user.target
